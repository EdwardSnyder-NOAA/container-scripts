#!/bin/bash
#set -x
#export img=/scratch1/NCEPDEV/nems/Mark.Potts/container-stage/ubuntu22.04-intel-ufs-env-v1.6.0.img
export SINGULARITY_SHELL=/bin/bash
arg="$@"
arg_lst=($arg)
if [[ -z $img ]]; then
  echo "export img to point to the container image you are using"
  exit 1
fi

# Get relevant dirs
bindir=`pwd | awk -F"/" '{print $2}'`
imgdir=$( echo "${img}" | awk -F"/" '{print $2}')
execdir=$( echo "${arg_lst[0]}" | awk -F"/" '{print $2}')
# This variable is modified by the update_ss_container_compiler.sh script
new_compiler_dirs=()
# Clean the variable
clean_comp_dirs=()
IFS=',' read -r -a clean_comp_dirs <<< "${new_compiler_dirs[@]}"

# Set bind_dirs array, which comes from the convert-modules.py script
clean_bind_dirs=()
if [[ -z "${bind_dirs}" ]]; then
    echo "bind_dirs is unset"
else
    IFS=',' read -r -a clean_bind_dirs <<< "${bind_dirs}"
fi

# Combine all the dirs into dirs_arrary
for dir in $bindir $imgdir $execdir ${clean_comp_dirs[@]} ${clean_bind_dirs[@]}; do
    add_me=1
    for da in "${dirs_array[@]}"; do
        if [[ "$dir" == "$da" ]]; then
            echo "$dir is found in array. Break loop."
            add_me=0
            break
        fi
    done
    if [[ $add_me == 1 ]]; then
        echo "Add $dir to array"
        dirs_array+=($dir)
    fi
done

# Create bind dir string for cmd using dirs_arrary
cmd_dir=""
for d in "${dirs_array[@]}"; do
   cmd_dir="-B /$d $cmd_dir"
done

# Loop through files that need to be externalized
for efile in $arg;
   do binfile=$(file -L $efile | grep ELF)
      if [[ $binfile =~ "ELF" ]]; then
         echo $efile;
         # Call dot-externalize.sh script
         singularity exec -e $cmd_dir "${img}" /opt/container-scripts/dot-externalize.sh $efile
      fi;
done
